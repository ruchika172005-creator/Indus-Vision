APP_NAME="IndusVision — Industrial Quality Inspector"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

DATABASE_URL="sqlite:///./app.db"

UPLOAD_DIR="./uploads"
DATASETS_DIR="./datasets"
WEIGHTS_DIR="./weights"
REPORTS_DIR="./reports"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
GENAI_TIMEOUT_SECONDS=30

DEFAULT_CONFIDENCE_THRESHOLD=0.35
DEFAULT_IOU_THRESHOLD=0.45
CRITICAL_DEFECT_AREA_RATIO=0.15
HIGH_DEFECT_AREA_RATIO=0.08
MEDIUM_DEFECT_AREA_RATIO=0.03

CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
