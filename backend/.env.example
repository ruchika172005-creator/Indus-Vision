# Application Environment Configuration
APP_NAME="IndusVision — Industrial Quality Inspector"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Database Configuration (SQLite default, PostgreSQL compatible)
DATABASE_URL="sqlite:///./app.db"

# Storage Directories
UPLOAD_DIR="./uploads"
DATASETS_DIR="./datasets"
WEIGHTS_DIR="./weights"
REPORTS_DIR="./reports"

# Multimodal Generative AI (Google Gemini)
# Enter your Google AI Studio Gemini API Key here (or configure via Settings UI)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
GENAI_TIMEOUT_SECONDS=30

# Detection & Severity Thresholds
DEFAULT_CONFIDENCE_THRESHOLD=0.35
DEFAULT_IOU_THRESHOLD=0.45
CRITICAL_DEFECT_AREA_RATIO=0.15
HIGH_DEFECT_AREA_RATIO=0.08
MEDIUM_DEFECT_AREA_RATIO=0.03

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
